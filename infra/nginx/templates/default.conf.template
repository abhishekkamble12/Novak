# Rendered by the nginx image entrypoint into /etc/nginx/conf.d/default.conf.
# Only variables defined in the container environment are substituted, so nginx's own
# $variables below are left untouched.

# Docker's embedded DNS. Together with `resolve` below, nginx re-resolves service
# names, so restarting api/web (which can change their IPs) doesn't cause 502s.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend_api {
    zone backend_api 64k;
    server api:3000 resolve;
    keepalive 32;
}

upstream frontend_web {
    zone frontend_web 64k;
    # web:80 (nginx serving the build) in prod, web:5173 (Vite) in dev
    server ${NOVAK_WEB_UPSTREAM} resolve;
}

server {
    listen 80;
    server_name localhost;

    # Node API Routes
    location /api/ {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket Connection
    location /socket.io/ {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Frontend Client (upgrade headers let Vite's HMR websocket through in dev)
    location / {
        proxy_pass http://frontend_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
