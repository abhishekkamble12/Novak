# ==============================================================================
# LUMEN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as required
# ==============================================================================

# --- Node API (apps/api) ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://localhost:27017/lumen
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=super-secret-access-token-key-change-in-production-min32chars
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudinary / Object Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Service Bridge
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-ai-service-shared-secret-key

# Monitoring & Logging
LOG_LEVEL=debug

# --- Python AI Service (apps/ai-service) ---
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
INTERNAL_API_SECRET=internal-ai-service-shared-secret-key

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_POSTS=lumen_posts_v1
QDRANT_API_KEY=

# Model Settings
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# --- Frontend Web (apps/web) ---
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
VITE_ENABLE_MOCK=false
