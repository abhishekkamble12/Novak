# ==============================================================================
# NOVAK ENVIRONMENT TEMPLATE (local development)
# Copy to .env. Production values are set in the Railway / Vercel dashboards;
# see DEPLOYMENT.md for the exact list per service.
# ==============================================================================

# --- Node API (apps/api) ---
NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://localhost:27017/novak
MONGO_DB_NAME=novak
REDIS_URL=redis://localhost:6379

# Dev-only placeholders. In production the API refuses to start unless each secret is a random
# value of 32+ chars that doesn't contain "change-me"/"development": openssl rand -base64 48
JWT_ACCESS_SECRET=development-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=development-refresh-secret-change-me-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated browser origins. One "*" wildcard per host is allowed,
# e.g. https://novak-*.vercel.app for Vercel preview deployments.
CORS_ORIGIN=http://localhost,http://localhost:5173
# lax: browser reaches the API on the same origin (Vite proxy / Vercel rewrite)
COOKIE_SAMESITE=lax
# Proxy hops in front of the API: 1 = Railway edge or nginx, 2 = Vercel rewrite -> Railway
TRUST_PROXY=1

AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=internal-ai-service-shared-secret-key
AI_REQUEST_TIMEOUT_MS=60000
# Run the BullMQ worker and the pending-post reconciler inside the API process
ENABLE_WORKER=true
# Reconciler: how often it runs, and how old a "pending" post must be before it's re-checked
RECONCILE_INTERVAL_MS=60000
RECONCILE_STALE_MS=60000
# Per-IP rate limits (Redis-backed). Only disable for local load tests (scripts/bench.mjs)
RATE_LIMIT_ENABLED=true

LOG_LEVEL=debug

# --- Python AI Service (apps/ai-service) ---
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
# INTERNAL_API_SECRET above is shared by both services

# Qdrant runs in Docker (npm run infra:up); dashboard at http://localhost:6333/dashboard
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_POSTS=novak_posts_v2

# FastEmbed (ONNX, CPU-only). ~67 MB, downloaded on first start into apps/ai-service/.cache
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# Cosine-similarity floor for semantic hits, tuned on eval/dataset.json (docs/SEARCH_EVAL.md).
# Model-specific: re-run the eval if you change EMBED_MODEL_NAME.
SEARCH_MIN_SCORE=0.62

# --- Frontend Web (apps/web) ---
# Leave VITE_API_URL empty to use "/api" (Vite dev proxy locally, Vercel rewrite in production)
VITE_API_URL=
# Socket.IO origin. Empty = same origin (works locally through the Vite proxy)
VITE_SOCKET_URL=
# Optional image uploads: a Cloudinary cloud name + an *unsigned* upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
